@page
@model CodeBuildDeploy.Pages.Blog.ViewBlogEntryModel

@section styles {
    <link rel="stylesheet" href="~/vendor/prism/prism.css">
}

<!-- Blog Post -->
@{
    if (Model.Post != null && !string.IsNullOrEmpty(Model.Post.Content)) await Html.RenderPartialAsync(Model.Post.Content);
}

<!-- Blog Post Tags -->
<div class="container">
    <div class="row justify-content-center pt-6 pb-4">
        <div class="col-lg-9">
            <!-- Tags -->
            <div class="mb-4 text-center">
                <h3 class="h6 text-uppercase mb-4">Tags:</h3>
                <ul class="u-list-inline mb-2">
                    @{
                        if (Model.Post == null || Model.Post.Tags == null || Model.Post.Tags.Count == 0)
                        {
                            <li class="list-inline-item mb-1">
                                <a class="btn btn-outline-secondary btn-sm" href="javascript:void(0);">No Tags</a>
                            </li>
                        }
                        else
                        {
                            foreach (var tag in Model.Post.Tags)
                            {
                                <li class="list-inline-item mb-1">
                                    <a class="btn btn-outline-secondary btn-sm" href="javascript:void(0);">@tag.Name</a>
                                </li>
                            }
                        }
                    }
                </ul>
            </div>
            <!-- End Tags -->
        </div>
    </div>
</div>
<!-- End Blog Post Tags -->

<!-- Blog Post Author -->
@if (Model.Post?.Author is { } author)
{
    var avatarPath = string.IsNullOrWhiteSpace(author.AvatarPath) ? "/img/user-blank.jpg" : author.AvatarPath;
    var links = new[]
    {
        (Url: author.LinkedInUrl, Icon: "bi-linkedin", Label: "LinkedIn"),
        (Url: author.TwitterUrl, Icon: "bi-twitter-x", Label: "X"),
        (Url: author.FacebookUrl, Icon: "bi-facebook", Label: "Facebook")
    };

    <div class="container bg-light content-space-1 mb-5">
        <div class="row justify-content-lg-center">
            <div class="col-lg-8">
                <div class="mb-5">
                    <h5>About the author:</h5>
                </div>
                <div class="d-sm-flex">
                    <div class="flex-shrink-0 mb-3 mb-sm-0">
                        <img class="avatar avatar-xl avatar-circle" src="@avatarPath" alt="@author.Name">
                    </div>
                    <div class="flex-grow-1 ms-sm-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="mb-0">
                                <span class="text-dark">@author.Name</span>
                            </h4>
                            <ul class="list-inline mb-0">
                                @foreach (var link in links)
                                {
                                    if (System.Uri.TryCreate(link.Url, System.UriKind.Absolute, out var url) && url.Scheme == System.Uri.UriSchemeHttps)
                                    {
                                        <li class="list-inline-item">
                                            <a class="btn btn-soft-secondary btn-icon btn-sm rounded-circle" href="@url.AbsoluteUri" aria-label="@link.Label">
                                                <i class="@link.Icon"></i>
                                            </a>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                        @if (author.Biography is { } biography)
                        {
                            foreach (var paragraph in biography.ReplaceLineEndings("\n").Split("\n\n", System.StringSplitOptions.RemoveEmptyEntries | System.StringSplitOptions.TrimEntries))
                            {
                                <p>@paragraph</p>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<!-- End Blog Post Author -->

<!-- End Blog Post -->
@section scripts {
    <script src="~/vendor/prism/prism.js"></script>
}
